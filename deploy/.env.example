# 복사해서 .env로 저장하고 값 채우기
# cp .env.example .env && nano .env

# JWT 서명용 시크릿 (아무 긴 랜덤 문자열. 한번 정하면 바꾸지 말 것)
JWT_SECRET=change-me-to-a-long-random-string

# GitHub OAuth 앱 (https://github.com/settings/developers 에서 생성)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# OAuth 콜백 URL (도메인 정해지면 업데이트)
REDIRECT_URI=https://your-domain.duckdns.org/auth/github/callback

# 배포할 도메인 (nginx/default.conf의 YOUR_DOMAIN과 일치해야 함)
DOMAIN=your-domain.duckdns.org

# Let's Encrypt 인증서 발급용 이메일
EMAIL=you@example.com
